---
import Container from "@components/layout/Container.astro";
import Section from "@components/layout/Section.astro";
import Stack from "@components/layout/Stack.astro";
import { SITE } from "@config";
import type { InferEntrySchema } from "astro:content";

type Section_ = NonNullable<InferEntrySchema<"pages">["sections"]>[number];

interface Props {
  block: Extract<Section_, { type: "quoteFeatureBlock" }>;
  index: number;
}

const { block } = Astro.props;
const { id, quote, attribution, authorName } = block;

const siteOrigin = (Astro.site ?? new URL(SITE.website)).toString().replace(/\/$/, "");
const orgId = `${siteOrigin}/#organization`;

// Only emit Review schema when we have a named author — Google's structured-data
// guidelines treat anonymous reviews as ineligible for rich results.
const reviewSchema = quote && authorName && {
  "@context": "https://schema.org",
  "@type": "Review",
  reviewBody: quote,
  itemReviewed: { "@id": orgId },
  author: { "@type": "Person", name: authorName },
  reviewRating: {
    "@type": "Rating",
    ratingValue: "5",
    bestRating: "5",
  },
};
---

{reviewSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
)}

<Section class="QuoteFeatureBlock" padding="xl" id={id}>
  <Container>
    <div class="quote-wrap">
      <Stack space="md" align="center">
        <svg
          class="quote-mark"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M7 7h3a1 1 0 0 1 1 1v3a3 3 0 0 1-3 3H7a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zm9 0h3a1 1 0 0 1 1 1v3a3 3 0 0 1-3 3h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z"
          ></path>
        </svg>

        <blockquote class="quote">
          <p>{quote}</p>
        </blockquote>

        {attribution && <p class="attribution">{attribution}</p>}
      </Stack>
    </div>
  </Container>
</Section>

<style>
  /* TODO: final styling — refine accent colour / type scale */
  .QuoteFeatureBlock {
    background-color: var(--color-accent);
    color: var(--color-background);
    text-align: center;

    .quote-wrap {
      max-width: 60ch;
      margin-inline: auto;
    }

    .quote-mark {
      width: 1.5rem;
      height: 1.5rem;
    }

    .quote p {
      font-size: var(--font-size-2);
      line-height: var(--line-height);
      /* font-weight: var(--font-weight-bold); */
    }

    .attribution {
      font-size: var(--font-size--1);
      letter-spacing: var(--letter-spacing-loose);
      text-transform: uppercase;
      display: flex;
      justify-content: center;
      flex-direction: column;
      gap: var(--space-md);

      &::before {
        content: "— ";
      }
    }
  }
</style>
