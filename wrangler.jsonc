{
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "artlogicspecialist",
	"compatibility_date": "2026-04-13",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"routes": [
		{
			"pattern": "artlogicspecialist.com",
			"custom_domain": true
		},
		{
			"pattern": "www.artlogicspecialist.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
